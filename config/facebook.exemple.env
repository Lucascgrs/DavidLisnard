# Copier ce fichier en config/facebook.env et le remplir avec le compte Facebook créé pour la collecte (jamais un
# compte personnel : un blocage ne toucherait que lui). Ce compte doit être membre des groupes de
# config/perimetre.json (rubrique « facebook »). Sert seulement à la connexion : python -m collecte.connexion_facebook
FB_MAIL=adresse@exemple.fr
FB_MDP=mot_de_passe
