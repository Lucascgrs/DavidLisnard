{
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/",
      "destination": "/commentaires.html",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/commentaires.html",
      "permanent": false
    },
    {
      "source": "/statistiques.html",
      "destination": "/commentaires.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
